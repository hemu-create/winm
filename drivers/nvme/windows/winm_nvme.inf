[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/03/2026,0.1.0.0
CatalogFile=winm_nvme.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12
WinM_CopyFiles=12

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
winm_nvme.sys=1,,

[Manufacturer]
%Provider%=WinM,NTARM64

[WinM.NTARM64]
%DeviceName%=WinM_Install,ACPI\WINM0002

[WinM_Install.NT]
CopyFiles=WinM_CopyFiles

[WinM_Install.NT.Services]
AddService=winm_nvme,%SPSVCINST_ASSOCSERVICE%,WinM_Service

[WinM_Install.NT.Wdf]
KmdfService=winm_nvme,WinM_WdfSection

[WinM_WdfSection]
KmdfLibraryVersion=1.15

[WinM_Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\winm_nvme.sys

[WinM_CopyFiles]
winm_nvme.sys

[Strings]
Provider="WinM"
DiskName="WinM NVMe Driver"
DeviceName="WinM Apple NVMe Controller"
ServiceName="WinM NVMe"
SPSVCINST_ASSOCSERVICE=0x00000002
